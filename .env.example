# Port (Render assigns PORT automatically in production)
PORT=5001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expiry_date_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expiry_date_manager

# JWT Authentication Secret & Token Expiry
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Frontend Allowed Origin (Netlify URL in production, or comma-separated URLs)
# Example: https://your-site-name.netlify.app
CORS_ORIGIN=*

# Environment
NODE_ENV=production
